{
  "name": "homescope-addon",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "morgan": "^1.12.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "uplot": "^1.6.32",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "baseline-browser-mapping": "2.11.0",
    "body-parser": "1.20.9",
    "browserslist": "4.28.7",
    "tsx": {
      "esbuild": "0.28.1"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2"
  }
}
